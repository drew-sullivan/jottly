# Apple requires the app-site-association file to be served as JSON. Serve it from both the canonical
# /.well-known path AND the legacy root path (belt-and-suspenders for older AASA lookups); both files are
# kept byte-identical by verify-fallbacks.sh.
/.well-known/apple-app-site-association
  Content-Type: application/json
/apple-app-site-association
  Content-Type: application/json

# The product dashboard shell contains no data, but it is intentionally private and should never be
# indexed or cached. Its script can fetch only same-origin aggregate reports.
/analytics*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
