{
  "name": "jottly",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB"
    }
  ]
}
